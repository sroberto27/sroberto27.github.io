# DTS migration credentials — copy to .env and fill in real values.
# .env is git-ignored (see .gitignore); NEVER commit real values.
# Production credentials go in a separate .env.prod at Handoff, also git-ignored.
# Full setup walkthrough: docs/migration/ACCOUNT-SETUP-AND-HANDOFF.md
# Reference: docs/migration/AUTOMATION-AND-CREDENTIALS.md

# --- Supabase (needed starting Phase 3) ---

# Your Supabase account -> Access Tokens -> New token.
# Lets the Supabase CLI link to and push migrations against your project.
SUPABASE_ACCESS_TOKEN=

# Set when you create the Supabase project (dashboard -> New project).
SUPABASE_DB_PASSWORD=

# Project settings -> API -> Project URL.
SUPABASE_URL=

# Project settings -> API -> anon/public key. Safe to be public — this is
# also the value that ends up in the committed js/supabase-init.js.
SUPABASE_ANON_KEY=

# Project settings -> General -> Reference ID.
SUPABASE_PROJECT_REF=

# Project settings -> API -> service_role key.
# NEVER expose this to the browser or commit it. Required starting Phase 3
# for scripts/seed-dev.mjs and every admin-only Function from Phase 5b
# onward (bypasses RLS deliberately, at a controlled server-side boundary).
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare (needed starting Phase 1) ---

# Dashboard -> My Profile -> API Tokens -> Create Token -> Custom token.
# Scope to exactly: Pages:Edit, R2:Edit. Not the Global API Key.
CLOUDFLARE_API_TOKEN=

# Visible on the sidebar of almost any Cloudflare dashboard page.
CLOUDFLARE_ACCOUNT_ID=
